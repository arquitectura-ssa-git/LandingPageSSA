---
import LogoBajada from '../assets/brand/logo-ssa-bajada.svg';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
const redes = [
  { label: 'Instagram', href: site.social.instagram },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'Facebook', href: site.social.facebook },
].filter((r) => r.href);
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-logo">
      <LogoBajada aria-label={site.name} role="img" />
    </div>

    <div class="grid footer-grid">
      <ol class="footer-nav">
        {nav.map((item) => (
          <li><a href={item.href}><span class="nav-n">{item.n}</span>{item.label}</a></li>
        ))}
      </ol>

      {redes.length > 0 && (
        <ul class="footer-social">
          {redes.map((r) => (
            <li><a href={r.href} target="_blank" rel="noopener">{r.label}</a></li>
          ))}
        </ul>
      )}

      <p class="footer-meta label">
        <span>{site.location}</span>
        <span>© {year} {site.name}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--smoky-black);
    color: var(--cultured);
    padding: clamp(80px, 10vw, 160px) 0 32px;
  }
  .footer-logo {
    display: flex;
    justify-content: center;
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .footer-logo :global(svg) { width: min(560px, 80%); height: auto; }

  .footer-grid {
    row-gap: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    align-items: start;
  }
  .footer-nav { grid-column: 1 / span 4; display: flex; flex-wrap: wrap; gap: 12px 32px; }
  .footer-nav a, .footer-social a { display: inline-flex; gap: 6px; font-size: var(--fs-small); opacity: 0.8; }
  .footer-nav a:hover, .footer-social a:hover { opacity: 1; }
  .nav-n { font-size: 0.625rem; letter-spacing: 0.08em; opacity: 0.6; }
  .footer-social { grid-column: 5 / span 3; display: flex; gap: 24px; }
  .footer-meta {
    grid-column: 8 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    color: rgba(242, 242, 242, 0.55);
  }

  @media (max-width: 720px) {
    .footer-nav, .footer-social, .footer-meta { grid-column: 1 / -1; }
    .footer-meta { align-items: flex-start; }
  }
</style>
