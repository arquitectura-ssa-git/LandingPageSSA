---
import { Picture } from 'astro:assets';
import { proyectos, proyectosDestacados, metaProyecto, formatM2 } from '../lib/contenido';

const INICIALES = 9; // obras visibles antes de "Ver más"
const destacadosSlugs = new Set(proyectosDestacados.map((p) => p.slug));
const grilla = proyectos.filter((p) => !destacadosSlugs.has(p.slug));
const filtros = [
  { id: 'todos', label: 'Todos', n: grilla.length },
  { id: 'Residenciales', label: 'Residenciales', n: grilla.filter((p) => p.categoria === 'Residenciales').length },
  { id: 'Otros proyectos', label: 'Otros proyectos', n: grilla.filter((p) => p.categoria === 'Otros proyectos').length },
].filter((f) => f.n > 0);
---
<section class="proyectos" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <header class="grid proy-head">
      <p class="label label-bracket proy-label" data-reveal>02 — Proyectos</p>
      <h2 class="proy-title" id="proyectos-title" data-reveal style="--delay:.06s">Obras seleccionadas</h2>
    </header>

    {proyectosDestacados.length > 0 && (
      <ol class="destacados">
        {proyectosDestacados.map((p, i) => (
          <li class:list={['grid destacado', { 'is-reverse': i % 2 === 1 }]}>
            <button type="button" class="destacado-media" data-abrir-proyecto={p.slug} aria-label={`Ver ${p.nombre}`} data-reveal>
              <Picture
                src={p.portada}
                alt=""
                formats={['webp']}
                widths={[640, 960, 1400, 1900]}
                sizes="(max-width: 960px) 100vw, 62vw"
                loading="lazy"
              />
            </button>
            <div class="destacado-info" data-reveal style="--delay:.1s">
              <span class="label destacado-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="destacado-name">{p.nombre}</h3>
              <dl class="destacado-datos">
                {p.tipo && (<><dt>Tipo</dt><dd>{p.tipo}</dd></>)}
                {p.ubicacion && (<><dt>Ubicación</dt><dd>{p.ubicacion}</dd></>)}
                {p.anio && (<><dt>Año</dt><dd>{p.anio}</dd></>)}
                {p.superficie && (<><dt>Superficie</dt><dd>{formatM2(p.superficie)}</dd></>)}
              </dl>
              {p.resumen && <p class="destacado-resumen">{p.resumen}</p>}
              <button type="button" class="link-arrow destacado-link" data-abrir-proyecto={p.slug}>
                Ver proyecto <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>
          </li>
        ))}
      </ol>
    )}

    {grilla.length > 0 && (
      <div class="mas" data-grilla data-iniciales={INICIALES}>
        <div class="mas-head">
          <h3 class="label label-bracket mas-label">Más proyectos</h3>
          {filtros.length > 2 && (
            <div class="filtros" role="group" aria-label="Filtrar proyectos por categoría">
              {filtros.map((f, i) => (
                <button type="button" class="filtro" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {f.label} <span class="filtro-n">{f.n}</span>
                </button>
              ))}
            </div>
          )}
        </div>

        <ul class="cards">
          {grilla.map((p, i) => (
            <li class="card" data-categoria={p.categoria} hidden={i >= INICIALES}>
              <button type="button" class="card-btn" data-abrir-proyecto={p.slug}>
                <span class="card-media">
                  <Picture
                    src={p.portada}
                    alt=""
                    formats={['webp']}
                    widths={[480, 720, 1000]}
                    sizes="(max-width: 720px) 100vw, (max-width: 1280px) 50vw, 32vw"
                    loading="lazy"
                  />
                </span>
                <span class="card-text">
                  <span class="card-name">{p.nombre}</span>
                  <span class="card-meta">{metaProyecto(p)}</span>
                </span>
                {p.anio && <span class="card-year label">{p.anio}</span>}
              </button>
            </li>
          ))}
        </ul>

        <div class="mas-foot">
          <button type="button" class="btn btn-dark" data-ver-mas hidden={grilla.length <= INICIALES}>
            Ver más proyectos <span class="arrow" aria-hidden="true">↓</span>
          </button>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .proyectos { padding: clamp(80px, 10vw, 160px) 0; background: var(--cultured); border-top: 1px solid var(--line-light); }

  .proy-head { row-gap: 16px; margin-bottom: clamp(48px, 6vw, 96px); }
  .proy-label { grid-column: 1 / span 2; color: var(--sonic-silver); padding-top: 0.5em; }
  .proy-title { grid-column: 3 / -1; font-size: var(--fs-h2); }

  /* Destacados */
  .destacados { display: flex; flex-direction: column; gap: clamp(64px, 9vw, 140px); }
  .destacado { row-gap: 24px; align-items: end; }
  .destacado-media {
    grid-column: 1 / span 7;
    display: block; padding: 0; border: 0; background: none; cursor: pointer;
    overflow: hidden;
  }
  .destacado-media :global(img) {
    width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .destacado-media:hover :global(img) { transform: scale(1.025); }
  .destacado-info { grid-column: 8 / -1; display: flex; flex-direction: column; gap: 18px; }
  .is-reverse .destacado-media { grid-column: 4 / -1; grid-row: 1; }
  .is-reverse .destacado-info { grid-column: 1 / span 3; grid-row: 1; }

  .destacado-n { color: var(--sonic-silver); }
  .destacado-name { font-size: var(--fs-h2); }
  .destacado-datos { display: grid; grid-template-columns: auto 1fr; column-gap: 20px; margin: 0; }
  .destacado-datos dt, .destacado-datos dd { margin: 0; padding: 9px 0; border-top: 1px solid var(--line-light); }
  .destacado-datos dt { font-size: var(--fs-label); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sonic-silver); padding-top: 12px; }
  .destacado-datos dd { font-size: var(--fs-small); }
  .destacado-resumen { color: var(--sonic-silver); font-size: 0.9375rem; }
  .destacado-link { align-self: flex-start; background: none; border-top: 0; border-left: 0; border-right: 0; color: inherit; cursor: pointer; font-family: inherit; padding-inline: 0; }

  /* Grilla */
  .mas { margin-top: clamp(96px, 12vw, 180px); }
  .mas-head {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px;
    padding-bottom: 20px; margin-bottom: 28px; border-bottom: 1px solid var(--line-light);
  }
  .mas-label { color: var(--sonic-silver); }
  .filtros { display: flex; flex-wrap: wrap; gap: 6px; }
  .filtro {
    min-height: 36px; padding: 0 14px;
    border: 1px solid var(--line-light); background: none; color: var(--lead-gray); cursor: pointer;
    font: 500 0.75rem/1 var(--font); letter-spacing: 0.1em; text-transform: uppercase;
    transition: all 0.3s var(--ease);
  }
  .filtro:hover { border-color: var(--lead-gray); }
  .filtro[aria-pressed='true'] { background: var(--lead-gray); border-color: var(--lead-gray); color: var(--cultured); }
  .filtro-n { opacity: 0.55; margin-left: 4px; }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px var(--gutter); }
  .card[hidden] { display: none; }
  .card-btn {
    width: 100%; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; font: inherit;
    display: grid; grid-template-columns: 1fr auto; gap: 14px 12px;
  }
  .card-media { grid-column: 1 / -1; display: block; overflow: hidden; background: var(--line-light); }
  .card-media :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 1s var(--ease); }
  .card-btn:hover .card-media :global(img) { transform: scale(1.04); }
  .card-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .card-name { font-size: 1rem; font-weight: 500; letter-spacing: 0.01em; }
  .card-meta { font-size: var(--fs-small); color: var(--sonic-silver); }
  .card-year { color: var(--sonic-silver); padding-top: 3px; }

  .mas-foot { display: flex; justify-content: center; margin-top: 56px; }
  .mas-foot [hidden] { display: none; }

  @media (max-width: 1280px) {
    .proy-label, .proy-title { grid-column: 1 / -1; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .destacado-media, .is-reverse .destacado-media { grid-column: 1 / -1; grid-row: auto; }
    .destacado-info, .is-reverse .destacado-info { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 720px) {
    .cards { grid-template-columns: 1fr; gap: 36px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-grilla]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const filtros = [...root.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const verMas = root.querySelector<HTMLButtonElement>('[data-ver-mas]')!;
    const iniciales = Number(root.dataset.iniciales) || 9;
    let filtro = 'todos';
    let expandido = false;

    const render = () => {
      const match = cards.filter((c) => filtro === 'todos' || c.dataset.categoria === filtro);
      cards.forEach((c) => (c.hidden = true));
      match.forEach((c, i) => (c.hidden = !expandido && i >= iniciales));
      verMas.hidden = expandido || match.length <= iniciales;
    };

    filtros.forEach((b) =>
      b.addEventListener('click', () => {
        filtro = b.dataset.filtro!;
        expandido = false;
        filtros.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render();
      }),
    );
    verMas.addEventListener('click', () => {
      expandido = true;
      render();
      const firstNew = cards.filter((c) => !c.hidden)[iniciales];
      firstNew?.querySelector('button')?.focus({ preventScroll: true });
    });
  }
</script>
