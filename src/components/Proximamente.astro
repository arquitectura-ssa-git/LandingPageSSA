---
/**
 * PROVISORIO (etapa B): muestra qué secciones se suman en la etapa C
 * y mantiene funcionando los enlaces del menú. Se elimina en la etapa C.
 */
const secciones = [
  { id: 'proyectos', n: '01', titulo: 'Proyectos', texto: 'Hitos, 3 obras destacadas y grilla con filtro Residenciales / Otros proyectos.' },
  { id: 'proceso', n: '03', titulo: 'Proceso', texto: 'Anteproyecto, proyecto y proyecto ejecutivo. Fundadores y reconocimientos.' },
  { id: 'contacto', n: '04', titulo: 'Contacto', texto: 'Formulario "Cotizá tu proyecto" y WhatsApp.' },
];
---
<section class="prox" aria-labelledby="prox-title">
  <div class="wrap">
    <div class="grid">
      <p class="label label-bracket prox-label">Vista previa · Etapa B</p>
      <h2 class="prox-title" id="prox-title">Próximas secciones</h2>
    </div>
    <ol class="prox-list">
      {secciones.map((s) => (
        <li id={s.id} class="grid prox-item">
          <span class="label prox-n">{s.n}</span>
          <h3 class="prox-name">{s.titulo}</h3>
          <p class="prox-text">{s.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .prox { padding: clamp(64px, 8vw, 120px) 0; background: var(--cultured); border-top: 1px solid var(--line-light); }
  .prox .grid { row-gap: 12px; }
  .prox-label { grid-column: 1 / span 2; color: var(--sonic-silver); padding-top: 0.6em; }
  .prox-title { grid-column: 3 / -1; font-size: var(--fs-h2); color: var(--sonic-silver); }
  .prox-list { margin-top: 40px; }
  .prox-item { padding: 20px 0; border-top: 1px solid var(--line-light); align-items: baseline; }
  .prox-n { grid-column: 1 / span 2; color: var(--sonic-silver); }
  .prox-name { grid-column: 3 / span 3; font-size: 1.125rem; letter-spacing: -0.01em; }
  .prox-text { grid-column: 6 / -1; color: var(--sonic-silver); }
  @media (max-width: 1280px) {
    .prox-label, .prox-title { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .prox-n { grid-column: 1 / span 1; }
    .prox-name { grid-column: 2 / -1; }
    .prox-text { grid-column: 2 / -1; }
  }
</style>
