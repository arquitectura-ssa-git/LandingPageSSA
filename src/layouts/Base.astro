---
import '../styles/global.css';
import { site } from '../data/site';
import { sitio, proyectosPortada } from '../lib/contenido';
import fontLight from '../assets/fonts/CreatoDisplay-Light.woff2?url';
import fontRegular from '../assets/fonts/CreatoDisplay-Regular.woff2?url';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: proyectosPortada[0].portada, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  additionalType: 'https://schema.org/Architect',
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  url: canonical.href,
  foundingDate: String(site.since),
  areaServed: 'Argentina',
  address: { '@type': 'PostalAddress', addressRegion: 'Tucumán', addressCountry: 'AR' },
  ...(sitio.contacto.email && { email: sitio.contacto.email }),
  ...(sitio.contacto.telefono && { telephone: sitio.contacto.telefono }),
  ...(sitio.redes.length && { sameAs: sitio.redes.map((r) => r.href) }),
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <link rel="preload" href={fontLight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      // Aparición de bloques al entrar en pantalla
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
